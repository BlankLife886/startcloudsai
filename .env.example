# ===== 基础 =====
APP_ENV_FILE=.env
APP_ENV=production
APP_SECRET=change-me-random-64-chars            # 设置加密主密钥；生产必须改为 >=32 位随机串
ALLOWED_ORIGINS=https://ai.example.com          # 生产环境只接受 HTTPS Origin
# 可信代理 CIDR（逗号分隔）：只信任这些网段设置的 X-Forwarded-For。
# 默认为 compose 内网网段；置空 = 不信任任何代理（直连部署时使用）。
TRUSTED_PROXIES=172.30.10.254/32

# ===== 数据库 / Redis（compose 内网默认值，一般不用改）=====
DATABASE_URL=postgres://starclouds:replace-with-a-strong-password@postgres:5432/starclouds?sslmode=disable
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
POSTGRES_PASSWORD=replace-with-a-strong-password
SERVER_DB_MAX_CONNS=10
SERVER_DB_MIN_CONNS=1
WORKER_DB_MAX_CONNS=5
WORKER_DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

# ===== chatgpt2api（你已部署的实例）=====
C2A_BASE_URL=https://your-c2a.example.com
C2A_API_KEY=your_auth_key_here
# 仅同机/受信网络回调需要；留空时自动关闭并继续使用轮询。
C2A_CALLBACK_SECRET=
C2A_ALLOW_PRIVATE=false
C2A_TIMEOUT_SECS=600

# ===== Sub2API（对话 + 生图工作区）=====
# Docker 内访问宿主机上的 Sub2API；非 Docker 运行可改为 http://localhost:8080
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_API_KEY=
SUB2API_CHAT_MODEL=gpt-5.4
SUB2API_IMAGE_MODEL=gpt-image-2
SUB2API_TIMEOUT_SECS=300

# CRUN async GPT Image 2 provider
CRUN_BASE_URL=https://api.crun.ai
CRUN_API_KEY=
CRUN_TIMEOUT_SECS=1200

# ===== 用户登录（Gmail / Googlemail / QQ 邮箱验证码）=====
SMTP_ADDR=smtp.example.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# 体验资格申请通知接收邮箱；留空时使用 SMTP_FROM
TRIAL_APPLICATION_EMAIL=owner@example.com

# ===== 蓝鲸支付（支付宝 / 微信二维码）=====
LANJING_PAY_BASE_URL=https://2347537.pay.lanjingzf.com
# 商户后台「系统设置」中的通讯密钥，不要提交真实值
LANJING_PAY_SECRET=
# 必须是支付平台可从公网访问的 HTTPS 地址
LANJING_PAY_NOTIFY_URL=https://ai.example.com/api/v1/payments/lanjing/notify
LANJING_PAY_TIMEOUT_SECS=10

# ===== S3 兼容对象存储（生产推荐：阿里云香港 OSS）=====
# 香港 ECS 同地域上传使用 internal endpoint；本地开发改用公网 endpoint。
OBJECT_STORAGE_ENDPOINT=https://s3.oss-cn-hongkong-internal.aliyuncs.com
# 预签名链接会返回给浏览器；内网 Endpoint 与公网 Endpoint 必须分开。
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
OBJECT_STORAGE_REGION=cn-hongkong
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=starcloudsai
OBJECT_STORAGE_USE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_EXPIRE_SECS=3600
# 可选：私有 OSS 回源 CDN。三项同时配置后，/files 鉴权成功的查看请求会跳转到 Type A 签名 URL。
OBJECT_STORAGE_CDN_BASE_URL=
# 只保存在服务端环境变量中，须与阿里云 CDN「URL 鉴权 / Type A」主密钥一致。
OBJECT_STORAGE_CDN_AUTH_KEY=
# 须与 CDN 控制台的鉴权有效时长一致，允许 60-86400 秒。
OBJECT_STORAGE_CDN_AUTH_TTL_SECS=900

# ===== 任务执行 =====
WORKER_CONCURRENCY=32
# 图片轮询协程上限；留空/0 时按并发与内存自动推导（多服务商部署建议显式调大）。
# WORKER_POLL_CONCURRENCY=8
USER_MAX_RUNNING_TASKS=100
WORKER_IMAGE_MEMORY_MIB=1024
# 扫描版 PDF OCR：固定命令路径、逐页处理，避免任意命令和无界资源占用。
ASSISTANT_OCR_ENABLED=true
ASSISTANT_OCR_PDFTOPPM_PATH=/usr/bin/pdftoppm
ASSISTANT_OCR_TESSERACT_PATH=/usr/bin/tesseract
ASSISTANT_OCR_LANGUAGES=chi_sim+eng
ASSISTANT_OCR_MAX_PAGES=20
ASSISTANT_OCR_TIMEOUT=90s
SERVER_GOMEMLIMIT=900MiB
WORKER_GOMEMLIMIT=1700MiB

# ===== 网关端口 =====
# 默认只供宿主机上的 HTTPS 反向代理访问，不直接暴露公网
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
