# This file is for an isolated local/staging stack. Never copy production data
# or secrets into it. Copy to .env.integrated and keep that file untracked.
APP_ENV=development
APP_SECRET=replace-with-a-random-value-at-least-32-characters
DEV_LOGIN_CODE_ECHO=true
ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXIES=172.31.10.254/32

# Use hex-only passwords so the values remain safe inside PostgreSQL URLs.
POSTGRES_SUPERUSER_PASSWORD=replace_with_random_hex
STARCLOUD_DB_NAME=starclouds
STARCLOUD_DB_USER=starclouds
STARCLOUD_DB_PASSWORD=replace_with_random_hex
CHATGPT2API_DB_NAME=chatgpt2api
CHATGPT2API_DB_USER=chatgpt2api
CHATGPT2API_DB_PASSWORD=replace_with_different_random_hex
REDIS_PASSWORD=replace_with_random_hex

# Absolute path to the clean ChatGPT2API 3.0 integration checkout.
CHATGPT2API_SOURCE_DIR=/Users/you/path/to/chatgpt2api-startcloud-integration
CHATGPT2API_AUTH_KEY=replace-with-a-different-random-value
# 集成 Compose 会复用此密钥签名容器内的图片任务终态回调。
CHATGPT2API_THREAD_TOKENS=120
CHATGPT2API_DATABASE_POOL_SIZE=10
CHATGPT2API_DATABASE_MAX_OVERFLOW=10
CHATGPT2API_BIND=127.0.0.1
CHATGPT2API_PORT=3000

# Local Docker cannot reach the Alibaba Cloud internal endpoint. Use a separate
# development bucket through the public Hong Kong endpoint.
OBJECT_STORAGE_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
# 同机生产环境可将上行 Endpoint 改为 internal，并在这里保留公网地址供浏览器预签名。
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=cn-hongkong
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=starcloudsai-development
OBJECT_STORAGE_USE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_EXPIRE_SECS=3600
UPLOAD_CLAMAV_ADDR=
UPLOAD_REVIEW_URL=
UPLOAD_REVIEW_KEY=
UPLOAD_SCAN_TIMEOUT=20s

SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_CHAT_MODEL=gpt-5.4
SUB2API_IMAGE_MODEL=gpt-image-2
SUB2API_TIMEOUT_SECS=300
CRUN_BASE_URL=https://api.crun.ai
CRUN_API_KEY=
CRUN_TIMEOUT_SECS=1200

WORKER_CONCURRENCY=32
WORKER_POLL_CONCURRENCY=8
WORKER_IMAGE_MEMORY_MIB=1280
USER_MAX_RUNNING_TASKS=100
SERVER_GOMEMLIMIT=640MiB
WORKER_GOMEMLIMIT=1900MiB

ASSISTANT_OCR_ENABLED=true
ASSISTANT_OCR_LANGUAGES=chi_sim+eng
ASSISTANT_OCR_MAX_PAGES=20
ASSISTANT_OCR_TIMEOUT=90s

GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
