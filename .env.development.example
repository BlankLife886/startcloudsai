# Local development only. Copy to .env.development and keep the gateway on loopback.
APP_ENV_FILE=.env.development
APP_ENV=development
APP_SECRET=local-development-secret-change-me
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3102,http://localhost:3104,http://localhost:3105,http://localhost:3200,http://127.0.0.1:8080,http://127.0.0.1:3102,http://127.0.0.1:3104,http://127.0.0.1:3105,http://127.0.0.1:3200
TRUSTED_PROXIES=172.30.10.254/32

DATABASE_URL=postgres://starclouds:starclouds@postgres:5432/starclouds
REDIS_PASSWORD=starclouds-redis-development-only
REDIS_URL=redis://:starclouds-redis-development-only@redis:6379/0
POSTGRES_PASSWORD=starclouds
SERVER_DB_MAX_CONNS=10
SERVER_DB_MIN_CONNS=1
WORKER_DB_MAX_CONNS=5
WORKER_DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m

C2A_BASE_URL=http://host.docker.internal:3000
C2A_API_KEY=
C2A_CALLBACK_SECRET=
C2A_ALLOW_PRIVATE=false
C2A_TIMEOUT_SECS=600

# Sub2API 的用户 API Key（不是 /admin/accounts 中的上游账号凭据）。
# Key 需要绑定启用了图片生成的 OpenAI 分组。
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_API_KEY=
SUB2API_CHAT_MODEL=gpt-5.4
SUB2API_IMAGE_MODEL=gpt-image-2
SUB2API_TIMEOUT_SECS=300

CRUN_BASE_URL=https://api.crun.ai
CRUN_API_KEY=
CRUN_TIMEOUT_SECS=1200

SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TRIAL_APPLICATION_EMAIL=
# 本地无 SMTP 时在登录响应中回显验证码。必须显式开启；生产环境即使设置也会被强制关闭。
DEV_LOGIN_CODE_ECHO=true

# 蓝鲸支付：本地开发默认关闭。联调时需使用公网 HTTPS 隧道作为通知地址。
LANJING_PAY_BASE_URL=https://2347537.pay.lanjingzf.com
LANJING_PAY_SECRET=
LANJING_PAY_NOTIFY_URL=
LANJING_PAY_TIMEOUT_SECS=10

# 本地无法访问阿里云内网 endpoint，请使用香港 OSS 公网 S3 兼容 endpoint。
OBJECT_STORAGE_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
# 留空时预签名链接复用 OBJECT_STORAGE_ENDPOINT。
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=cn-hongkong
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=starcloudsai-development
OBJECT_STORAGE_USE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_EXPIRE_SECS=3600
UPLOAD_CLAMAV_ADDR=
UPLOAD_REVIEW_URL=
UPLOAD_REVIEW_KEY=
UPLOAD_SCAN_TIMEOUT=20s

WORKER_CONCURRENCY=32
# 图片轮询协程上限；留空/0 时按并发与内存自动推导（多服务商部署建议显式调大）。
# WORKER_POLL_CONCURRENCY=8
USER_MAX_RUNNING_TASKS=100
WORKER_IMAGE_MEMORY_MIB=1024
SERVER_GOMEMLIMIT=900MiB
WORKER_GOMEMLIMIT=1700MiB

GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
