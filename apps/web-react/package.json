{
  "name": "@starcloudsai/web-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3105 --strictPort",
    "build": "vite build",
    "typecheck:canvas": "tsc -p tsconfig.canvas.json",
    "test:domain": "npm run test:image-sizes && npm run test:transparent-upscale && npm run test:coloring-upload-compression && npm run test:coloring-original-result && npm run test:history-pagination && npm run test:task-concurrency && npm run test:task-generation-timing && npm run test:theme-transition && npm run test:ecommerce-plan && npm run test:multi-device-consistency && npm run test:gallery-focus && npm run test:background-removal-linking && npm run test:analysis-node-geometry && npm run test:pixel-region-calibration && npm run test:region-geometry && npm run test:region-output-policy && npm run test:tile-precision-refine && npm run test:canvas-preview-url",
    "test:canvas-preview-url": "node --test --experimental-strip-types scripts/test-canvas-preview-url.mjs",
    "test:canvas-workflow": "node --test --experimental-strip-types scripts/test-canvas-workflow.mjs scripts/test-dev-performance-entry-guard.mjs",
    "test:image-sizes": "node scripts/test-image-output-size.mjs",
    "test:transparent-upscale": "node scripts/test-transparent-image-upscale.mjs",
    "test:coloring-upload-compression": "node scripts/test-coloring-upload-compression.mjs",
    "test:coloring-original-result": "node scripts/test-coloring-original-result.mjs",
    "test:history-pagination": "node --test scripts/test-history-pagination.mjs",
    "test:task-concurrency": "node --test scripts/test-task-concurrency.mjs",
    "test:task-generation-timing": "node scripts/test-task-generation-timing.mjs",
    "test:theme-transition": "node scripts/test-theme-transition.mjs",
    "test:ecommerce-plan": "node scripts/test-ecommerce-generation-plan.mjs && node scripts/test-ecommerce-business-isolation.mjs && node scripts/test-handheld-domain-boundary.mjs && node scripts/test-accessory-commerce.mjs",
    "test:multi-device-consistency": "node scripts/test-multi-device-consistency.mjs",
    "test:gallery-focus": "node scripts/test-gallery-focus.mjs",
    "test:background-removal-linking": "node scripts/test-background-removal-task-linking.mjs",
    "test:analysis-node-geometry": "node scripts/test-analysis-node-geometry.mjs",
    "test:pixel-region-calibration": "node scripts/test-pixel-region-calibration.mjs",
    "test:region-geometry": "node scripts/test-region-geometry.mjs",
    "test:region-output-policy": "node scripts/test-region-output-policy.mjs",
    "test:tile-precision-refine": "node scripts/test-tile-precision-refine.mjs",
    "test:tile-precision-refine:visual": "node scripts/test-tile-precision-refine-visual.mjs",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --grep @visual --project visual-desktop --project visual-mobile",
    "preview": "vite preview --host 127.0.0.1 --port 3105 --strictPort"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@gsap/react": "2.1.2",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "@tanstack/react-query": "^5.100.9",
    "antd": "^6.4.2",
    "bootstrap": "5.3.6",
    "bootstrap-icons": "1.13.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.20",
    "dompurify": "3.4.13",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "gsap": "3.15.0",
    "image-q": "4.0.0",
    "i18next": "^26.3.6",
    "localforage": "^1.10.0",
    "lucide-react": "^1.16.0",
    "marked": "18.0.7",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "ogl": "1.0.11",
    "pica": "10.0.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.11",
    "react-router": "8.3.0",
    "shadcn": "^4.7.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "5.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss-prefix-selector": "^2.1.1",
    "typescript": "^5",
    "vite": "7.3.6"
  }
}
