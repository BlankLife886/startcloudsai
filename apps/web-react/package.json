    "test:task-generation-timing": "node scripts/test-task-generation-timing.mjs",
    "test:task-generation-stage": "node scripts/test-task-generation-stage.mjs",
    "test:dynamic-import-recovery": "node scripts/test-dynamic-import-recovery.mjs",
